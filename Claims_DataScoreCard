/*Add trns_type to CLMTRNS*/

        PROC SQL;
        CREATE TABLE CLMTRNS_&c._Scorecard as SELECT
		h.*, case when h.ITEM_CLASS = 2 then "C" else t.TRANS_TYPE end as Trns_Type,
		case when day(TRANS_DATE)>Day(input(&Balancedate.,ddmmyy10.)) then case when Month(TRANS_DATE)=12 
				then Year(TRANS_DATE)+1 else Year(TRANS_DATE) end else Year(TRANS_DATE) end length = 3 as Acnt_Yr,
				case when day(TRANS_DATE)>Day(input(&Balancedate.,ddmmyy10.)) then case when Month(TRANS_DATE)=12 
				then 1 else Month(TRANS_DATE)+1 end else Month(TRANS_DATE) end length = 3 as Acnt_Mnth
		FROM CLMTRNS_&c._Scorecard h
		INNER JOIN TRANS_TYPE_MAP_&c. t ON (h.SPECIFICATION = t.SPECIFICATION);
		QUIT;

/*Add Reserve group to CLMTRNS for next correction*/

    PROC SQL;
	CREATE TABLE CLMTRNS_&c._Scorecard as
	SELECT p.*, q.Rsrv_Grp from CLMTRNS_&c._Scorecard p
