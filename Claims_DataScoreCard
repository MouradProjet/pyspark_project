/*Add TOTAL AMOUNT PAID to CLMHDR*/


		PROC SQL;
		CREATE TABLE TOTAL_AMOUNT_PAID_&c. as 
		SELECT CLA_CASE_NO, sum(-CURRENCY_AMT) as Totl_Amnt_Pd, sum(case when Trns_Type = "O" then 0 
		else -CURRENCY_AMT end) as Totl_Bnfts_Amnt_Pd
		FROM Clmtrns_&c._scorecard
		GROUP BY CLA_CASE_NO;
        QUIT;

	   PROC SQL;
	   CREATE TABLE CLMHDR_&c._Scorecard as SELECT
	   h.*, t.Totl_Amnt_Pd, t. Totl_Bnfts_Amnt_Pd
	   from CLMHDR_&c._Scorecard h
	   LEFT JOIN TOTAL_AMOUNT_PAID_&c. t on h.CLA_CASE_NO=t.CLA_CASE_NO;
	   QUIT;



   /*MAKE FRST BNFT PD YRMNTH*/

        PROC SQL;
		CREATE TABLE FIRSTLASTBENEFIT_&c. as 
		SELECT CLA_CASE_NO,

		case when day(min(TRANS_DATE))>Day(input(&Balancedate.,ddmmyy10.)) then case 
		when Month(min(TRANS_DATE))=12 then Year(min(TRANS_DATE))+1 else Year(min(TRANS_DATE)) end 
		else Year(min(TRANS_DATE)) end as Frst_Bnft_Pd_Yr,

		case when day(min(TRANS_DATE))>Day(input(&Balancedate.,ddmmyy10.)) then case 
		when Month(min(TRANS_DATE))=12 then 1 else Month(min(TRANS_DATE))+1 end 
		else Month(min(TRANS_DATE)) end as Frst_Bnft_Pd_Mnth,

		case when day(max(TRANS_DATE))>Day(input(&Balancedate.,ddmmyy10.)) then case 
		when Month(max(TRANS_DATE))=12 then Year(max(TRANS_DATE))+1 else Year(max(TRANS_DATE))end 
		else Year(max(TRANS_DATE)) end as latst_Bnft_Pd_Yr,

		case when day(max(TRANS_DATE))>Day(input(&Balancedate.,ddmmyy10.)) then case 
		when Month(max(TRANS_DATE))=12 then 1 else Month(max(TRANS_DATE))+1 end 
		else Month(max(TRANS_DATE)) end as latst_Bnft_Pd_Mnth

		FROM Clmtrns_&c._scorecard
		WHERE -CURRENCY_AMT >1 AND Trns_Type ne "O"
		GROUP BY CLA_CASE_NO;
        QUIT;

        
	   PROC SQL;
	   CREATE TABLE CLMHDR_&c._Scorecard as SELECT
	   h.*, t.Frst_Bnft_Pd_Yr, t.Frst_Bnft_Pd_Mnth, t.latst_Bnft_Pd_Yr, t.latst_Bnft_Pd_Mnth
	   from CLMHDR_&c._Scorecard h
	   LEFT JOIN FIRSTLASTBENEFIT_&c. t on h.CLA_CASE_NO=t.CLA_CASE_NO;
       QUIT;


/*ICOP*/

/*Q UPDT NMBR BNFTS PD*/
PROC SQL;
		UPDATE CLMHDR_&c._Scorecard
		SET Nmbr_Bnfts_Pd = case when Monthly_Benefit <=0 then 0 
							when Totl_Bnfts_Amnt_Pd/Monthly_Benefit < 1
							then 1
							when Totl_Bnfts_Amnt_Pd/Monthly_Benefit > 60
							then 60
							else int(Totl_Bnfts_Amnt_Pd/Monthly_Benefit+0.5) end
		WHERE Totl_Bnfts_Amnt_Pd > 1 and Benefit_Type= 'Monthly Benefit' ;
QUIT;


/*UPDT MAX MTH*/

        PROC SQL;
		UPDATE CLMHDR_&c._Scorecard
		SET Max_Mth = case when MAX_NO_OF_PAYMENTS <=(Year(Expry_Dt)*12+Month(Expry_Dt)-(Acc_Yr*12+Acc_Mnth))
		then MAX_NO_OF_PAYMENTS
	    else (Year(Expry_Dt)*12+Month(Expry_Dt)-(Acc_Yr*12+Acc_Mnth)) end,

        MAX_NO_OF_PAYMENTS_flag = case when MAX_NO_OF_PAYMENTS <=(Year(Expry_Dt)*12+Month(Expry_Dt)-(Acc_Yr*12+Acc_Mnth))
		then 0 else 1 end
        WHERE Benefit_Type= 'Monthly Benefit';
        QUIT;

/*This corrects the max number of benefits paid*/

PROC SQL;
		UPDATE CLMHDR_&c._Scorecard
		SET Max_Mth = Nmbr_Bnfts_Pd, MAX_NO_OF_PAYMENTS_flag = 1
		WHERE Nmbr_Bnfts_Pd > Max_Mth and Benefit_Type= 'Monthly Benefit' ;
QUIT;

/*Add GBP Benefit*/

PROC SQL;
		Create table CLMHDR_&c._Scorecard as select
		p.*,  q.EUR_Rate * (Case when p.Benefit_Type = 'Monthly Benefit' then p.Monthly_Benefit else p.OUTSTANDING_LIFE_BALANCE end) as Benefit_GBP
        from CLMHDR_&c._Scorecard p
		left join GBP_Rates q on p.Country=q.Country;
		Quit;

/*Add benefit measure for corrections*/

		PROC SQL;
		Create table CLMHDR_&c._Scorecard as select
		*, (COVER_flag+scheme_flag+incident_date_flag+COVER_START_DATE_flag+COVER_END_DATE_flag
        + FIRST_OPEN_DATE_flag+FIRST_CLOSE_DATE_flag+REOPEN_DATE_flag+RECLOSE_DATE_flag
        +STATUS_flag+INSURANCE_TERM_flag+UW_COMPANY_flag+MONTHLY_BENEFIT_flag+OUTSTANDING_BALANCE_flag
		+MAX_NO_OF_PAYMENTS_flag+DECISION_DATE_flag+Close_Date_flag+AGENT_LOAN_AGR_NO_flag) * Benefit_GBP as Adjusted_Benefit,
		(18*Benefit_GBP) - ((COVER_flag+scheme_flag+incident_date_flag+COVER_START_DATE_flag+COVER_END_DATE_flag
        + FIRST_OPEN_DATE_flag+FIRST_CLOSE_DATE_flag+REOPEN_DATE_flag+RECLOSE_DATE_flag
        +STATUS_flag+INSURANCE_TERM_flag+UW_COMPANY_flag+MONTHLY_BENEFIT_flag+OUTSTANDING_BALANCE_flag
		+MAX_NO_OF_PAYMENTS_flag+DECISION_DATE_flag+Close_Date_flag+AGENT_LOAN_AGR_NO_flag) * Benefit_GBP) as Unadjusted_Benefit
        from CLMHDR_&c._Scorecard;
		Quit;

		


/* Create final scorecard data */

        PROC SQL;
        CREATE TABLE &c._Scorecard_Counts as SELECT

        "&c." length = 11 as COUNTRY, Rsrv_Grp, Agent format=$40. Informat = $40. length=40, Scheme,  Cover, UW_Company, Legal_Entity length = 8 format=$8., Benefit_Type, Status, Count(CLA_CASE_NO) as Claim_Count, 
        sum(COVER_flag) as Cover_flag,
	    sum(scheme_flag) as Scheme_flag,
		sum(incident_date_flag) as Incident_Date_flag,
		sum(COVER_START_DATE_flag) as COVER_START_DATE_flag,
		sum(COVER_END_DATE_flag) as COVER_END_DATE_flag,
		sum(FIRST_OPEN_DATE_flag) as FIRST_OPEN_DATE_flag,
        sum(FIRST_CLOSE_DATE_flag) as FIRST_CLOSE_DATE_flag,
		sum(REOPEN_DATE_flag) as REOPEN_DATE_flag,
		sum(RECLOSE_DATE_flag) as RECLOSE_DATE_flag,
		sum(STATUS_flag) as STATUS_flag,
		sum(INSURANCE_TERM_flag) as INSURANCE_TERM_flag,
		sum(UW_COMPANY_flag) as UW_COMPANY_flag,
		sum(MONTHLY_BENEFIT_flag) as MONTHLY_BENEFIT_flag,
		sum(OUTSTANDING_BALANCE_flag) as OUTSTANDING_BALANCE_flag,
		sum(MAX_NO_OF_PAYMENTS_flag) as MAX_NO_OF_PAYMENTS_flag,
		sum(DECISION_DATE_flag) as DECISION_DATE_flag,
		sum(Close_Date_flag) as Close_Date_flag, 
		sum(AGENT_LOAN_AGR_NO_flag) as AGENT_LOAN_AGR_NO_flag,
		sum(COVER_flag)+sum(scheme_flag)+sum(incident_date_flag)+sum(COVER_START_DATE_flag)+sum(COVER_END_DATE_flag)
        + sum(FIRST_OPEN_DATE_flag)+ sum(FIRST_CLOSE_DATE_flag)+ sum(REOPEN_DATE_flag)+sum(RECLOSE_DATE_flag)
        +sum(STATUS_flag)+sum(INSURANCE_TERM_flag)+sum(UW_COMPANY_flag)+sum(MONTHLY_BENEFIT_flag)+sum(OUTSTANDING_BALANCE_flag)
		+ sum(MAX_NO_OF_PAYMENTS_flag) +sum(DECISION_DATE_flag) + sum(Close_Date_flag) + sum(AGENT_LOAN_AGR_NO_flag) as Adjusted_Variables,
        ((18*Count(CLA_CASE_NO))- (sum(COVER_flag)+sum(scheme_flag)+sum(incident_date_flag)+sum(COVER_START_DATE_flag)+sum(COVER_END_DATE_flag)
        + sum(FIRST_OPEN_DATE_flag)+ sum(FIRST_CLOSE_DATE_flag)+ sum(REOPEN_DATE_flag)+sum(RECLOSE_DATE_flag)
        +sum(STATUS_flag)+sum(INSURANCE_TERM_flag)+sum(UW_COMPANY_flag)+sum(MONTHLY_BENEFIT_flag)+sum(OUTSTANDING_BALANCE_flag)
		+ sum(MAX_NO_OF_PAYMENTS_flag) +sum(DECISION_DATE_flag) + sum(Close_Date_flag) + sum(AGENT_LOAN_AGR_NO_flag))) as Unadjusted_Variables,
        sum(Adjusted_Benefit) as Adjusted_Benefit,
		sum(Unadjusted_Benefit) as Unadjusted_Benefit

    FROM CLMHDR_&c._Scorecard 
    GROUP BY COUNTRY, Rsrv_Grp, Agent, Scheme, Cover, UW_Company, Legal_Entity, Benefit_Type, Status;
    QUIT; 

