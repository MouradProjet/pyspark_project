        case when (INSURANCE_TERM = 1) OR ((INSURANCE_TERM < 1 OR INSURANCE_TERM = .) AND IS_BULK = "Y") then COVER_END_DATE + 20*365
		else COVER_END_DATE end format = ddmmyy10. length = 4 as Expry_dt,
