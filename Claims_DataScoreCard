/*Creates a table of claims in CLMTRNS with the final transaction date and total amount paid
from CLMTRNS, plus first open date, first close date, reopen date, reclose date, close date and status from CLMHDR.
There is a filter here on ITEM_CLASS: I dont know what this is for but will receive an e-mail soon from 
Daly, Iomhar (Genworth) explaining it.*/
PROC SQL;
		CREATE TABLE CLAIMS_IN_CLMTRNS_&c. as 
		SELECT UNIQUE t.CLA_CASE_NO, max(t.TRANS_DATE) format=ddmmyy10. as TRANS_DATE, h.FIRST_OPEN_DATE,
		h.FIRST_CLOSE_DATE, h.REOPEN_DATE, h.RECLOSE_DATE, h.CLOSE_DATE, h.STATUS, 
		SUM(-CURRENCY_AMT) as AMT
		FROM Clmtrns_&c._Scorecard t
		INNER JOIN Clmhdr_&c._Scorecard h ON (h.CLA_CASE_NO = t.CLA_CASE_NO)
		WHERE t.ITEM_CLASS in (2,3,4)
		GROUP BY t.CLA_CASE_NO, h.FIRST_OPEN_DATE, h.FIRST_CLOSE_DATE, h.REOPEN_DATE, h.RECLOSE_DATE,
		h.CLOSE_DATE, h.STATUS;
QUIT;


/*Correction for monthly benefits outside limits.*/

 PROC SQL;
		 UPDATE CLMHDR_&c._Scorecard h
		 SET Monthly_Benefit_Flag = 1
         WHERE (h.MONTHLY_BENEFIT < (SELECT Mnthly_bnft_limits_&c..LOWER FROM Mnthly_bnft_limits_&c. WHERE h.Rsrv_Grp = Mnthly_bnft_limits_&c..Rsrv_Grp)
		 OR h.MONTHLY_BENEFIT > (SELECT Mnthly_bnft_limits_&c..UPPER FROM Mnthly_bnft_limits_&c. WHERE h.Rsrv_Grp = Mnthly_bnft_limits_&c..Rsrv_Grp)
		 OR h.MONTHLY_BENEFIT = .)
         AND h.STATUS in ("OP","RO");

QUIT;

/*Make a table of claims with monthly benefits outside limits. */


PROC SQL;
		CREATE TABLE MNTHLY_BNFT_CORR_&c. as 
		SELECT h.CLA_CASE_NO, h.Rsrv_Grp, h.Prod_Id, h.SCHEME, h.COVER, h.MONTHLY_BENEFIT,
		0.00001 as Mnthly_Bnft_Corr, h.STATUS
		FROM Clmhdr_&c._Scorecard h
		INNER JOIN Mnthly_bnft_limits_&c. m
		ON (h.Rsrv_Grp = m.Rsrv_Grp)
		WHERE (h.MONTHLY_BENEFIT < m.LOWER
		or h.MONTHLY_BENEFIT > m.UPPER
		or h.MONTHLY_BENEFIT = .)
		AND h.STATUS in ("OP","RO");
QUIT;

/*Make average benefit by product. For UK this is done at scheme level. Consider removal of UK exception.*/
%IF &c. = UK  %THEN %DO;
PROC SQL;
		CREATE TABLE MTHLY_BNFT_AVG_PRDCT_&c. as 
		SELECT h.Rsrv_Grp, h.Scheme, count(h.CLA_CASE_NO) as COUNT, MEAN(h.MONTHLY_BENEFIT) as AVG_MONTHLY_BENEFIT,
		STD(h.MONTHLY_BENEFIT) as STD_MONTHLY_BENEFIT
		FROM Clmhdr_&c._Scorecard h
		INNER JOIN Mnthly_bnft_limits_&c. m
		ON (h.Rsrv_Grp = m.Rsrv_Grp)
		WHERE h.MONTHLY_BENEFIT > m.LOWER
		AND h.MONTHLY_BENEFIT < m.UPPER
		GROUP BY h.Rsrv_Grp, h.Scheme;
QUIT;
%END;

%ELSE %DO;
PROC SQL;
		CREATE TABLE MTHLY_BNFT_AVG_PRDCT_&c. as 
		SELECT h.Rsrv_Grp, h.Prod_Id, count(h.CLA_CASE_NO) as COUNT, MEAN(h.MONTHLY_BENEFIT) as AVG_MONTHLY_BENEFIT,
