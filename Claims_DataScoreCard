/*Add benefit type*/
		
		PROC SQL;
		CREATE TABLE CLMHDR_&c._Scorecard as SELECT
		*, case when Rsrv_Grp IN('GR1','GR3','GD1','GD3') then 'Monthly Benefit' 
         else case when Rsrv_Grp IN('ZZ1','ZZ2')  then '.' else 'Lump Sum' end end as Benefit_Type
		 from CLMHDR_&c._Scorecard;
