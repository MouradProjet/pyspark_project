/********************création d'une base avec tous les postes pour appliquer la cession*********************/
/************************MISE EN FORME BASE CY**************************************************/

data donnees_cy_tout ;
set cqs_out.bgd_idean_cqs_cbp_cy; 
where poste in("PRIMES","PSAP","SINISTRES","PPNA");
generation=2025;
keep IDEAN generation surv gar poste Montant traite ;
run; 

/*************** Mise en forme de la base PY****************/

/********************************* UEP **********************/

proc sql;
create table UEP as select 
idean,gen as Generation, SURV, gar, Type_Pret,sum(UEP) as PPNA 
from cqs_out.cqs_uep_pl_3
group by idean, Generation,SURV, gar, Type_Pret ; quit;

data UEP;
set UEP ;
if idean=. then delete ;
if idean=1 then delete; run; 

proc sort data= UEP OUT=UEP ;
by idean Generation SURV gar Type_Pret ; run ;

proc transpose data=UEP out = UEP ; 
var PPNA ; 
by idean Generation SURV gar Type_Pret ; 
run ; 

DATA UEP ;
set UEP;
rename _NAME_=POSTE;
rename COL1=Montant ; run; 

/********************* PSAP **********************************/

proc sql ;
create table reserves as select 
idean, gar,surv,generation as Generation, type_pret,sum(reserves) as PSAP
from  cqs_sin.claims_actuals_9
group by idean, gar, surv, Generation, type_pret ; quit; 

proc sort data=reserves out=reserves ;
by idean Generation SURV gar Type_Pret ; run; 

proc transpose data=reserves out=reserves ;
var PSAP ;
by idean Generation SURV gar Type_Pret ; 
run ;  

DATA reserves ;
set reserves ;
rename _NAME_=POSTE ;
rename COL1= Montant ;
idean_char=put(idean,8.) ;
drop idean; 
rename idean_char=idean; 
run; 


/****************consolidation de la base PY clot cession ********/

data donnees_py ;
format POSTE $15.;
set uep reserves ;
run; 

DATA donnees_cy;
set cqs_out.bgd_idean_cqs_cbp_cy ;
where poste in("PPNA","PSAP") ;
run;

/***********************TRAITE CQP PY ********************/

%macro split_cess_cqp(cess,taux);
data cess_py_cqp_&cess.;
set donnees_py ;
where 2019<=generation<=2022 and type_pret="CQP" and gar=10 ;
if poste in("PPNA"/*,"PRIMES","CANCEL"*/) then cess=-montant*(1-0.276)*&taux. ;
else if poste in (/*"SINISTRES",*/"PSAP") then cess=-montant*&taux.;
code_cess="&cess." ;
run; 
%mend;

%split_cess_cqp(RGA,0.9);


/************** TRAITE INFORCE PY ***********/
/* On n'enleve pas les frais des UEP cédés pour le traite inforce, c'est pas du new business, que 
du run-off */
/*  V2 DU CODE INFORCE ******/

%macro split_cess_inforce(cess, taux);
    data cess_py_traite_inforce_&cess.;
    set donnees_py;
	    cess = .; 
        code_cess = "&cess."; 
        
        
        if generation <= 2022 and type_pret not in ("CQP") then do; 
            if poste in("PPNA") then cess = -montant * 0.96 * &taux.; 
            else if surv > 2022 and poste in ("PSAP") then cess = -montant * &taux.; 
            output; 
        end;

        
        if generation <= 2018 and type_pret = "CQP" then do;
            if poste in("PPNA") then cess = -montant * &taux. * 0.96;
            else if surv > 2022 and poste in ("PSAP") then cess = -montant * &taux.; 
            output; 
        end;

        
        if 2019 <= generation <= 2022 and type_pret = "CQP" and gar = 30 then do;
            if poste in("PPNA") then cess = -montant * &taux. * 0.96;
            else if surv > 2022 and poste in ("PSAP") then cess = -montant * &taux.; 
            output; 
        end;


run;
%mend;
%split_cess_inforce(MAPFRE, 0.09);
%split_cess_inforce(RGA, 0.45);
%split_cess_inforce(SCOR, 0.1);
%split_cess_inforce(ARCH, 0.05);



/*************** TRAITE NEW BUSINESS PY **********/

%macro split_cess_newb (cess,taux);
data cess_py_newb_&cess.;
set donnees_py ;

cess = .; 
code_cess="&cess." ; 

where generation>=2023;

if poste in("PPNA") then cess=-montant*(1-0.276)*&taux.; 
if poste in ("PSAP") then cess=-montant*&taux.; 


run; 
%mend;

%split_cess_newb(RGA,0.4);
%split_cess_newb(SCOR,0.1);
%split_cess_newb(MAPFRE,0.1);
%split_cess_newb(GEN_RE,0.1);

