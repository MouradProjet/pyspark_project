%split_cess_newb_cy(GEN_RE,0.1);


/**************CONSOLIDATION DES SORTIES **********/
data bgd_cqs_cession;
    set 
	    cess_py_traite_inforce_mapfre
        cess_py_cqp_rga
        
        cess_py_traite_inforce_arch
        
        cess_py_traite_inforce_rga
        cess_py_traite_inforce_scor
        
