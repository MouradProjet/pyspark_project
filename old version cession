code_cess="&cess." ;

if poste in("PPNA") then cess=-montant*(1-0.276)*&taux.;
else if poste in ("PSAP") then cess=-montant*&taux.;
code_cess="&cess." ; 
run; 
%mend;
%split_cess_newb_cy(RGA,0.4);
