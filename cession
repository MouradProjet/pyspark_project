def split_cess_cqp(cess, taux):
    _dfs[f'cess_py_cqp_{cess}'] = spark.table('donnees_py')
    _dfs[f'cess_py_cqp_{cess}'] = _dfs[f'cess_py_cqp_{cess}'].filter(F.expr("""2019 <= generation AND generation <= 2022 AND type_pret='CQP' AND gar=10"""))
    _dfs[f'cess_py_cqp_{cess}'] = (_dfs[f'cess_py_cqp_{cess}']
        .withColumn('cess',
            F.when(F.expr("""poste IN ("PPNA")"""), F.expr(f"""-montant*(1-0.276)*{taux}"""))
             .when(F.expr("""poste IN ("PSAP")"""), F.expr(f"""-montant*{taux}""")))
        .withColumn('code_cess', F.lit("{cess}"))
    )
    _dfs[f'cess_py_cqp_{cess}'].createOrReplaceTempView(f'cess_py_cqp_{cess}')


