if idean=. then delete ;
if idean=1 then delete; run; 

proc sort data= UEP OUT=UEP ;
by idean Gen SURV gar Type_Pret ; run ;

proc transpose data=UEP out = UEP ; 
var PPNA ; 
by idean Gen SURV gar Type_Pret ; 
run ; 

DATA UEP ;
set UEP;
rename _NAME_=POSTE;
rename COL1=Montant ; 
run; 

