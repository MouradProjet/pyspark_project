/******************  exporter dans la base clause avec clause ficitive que je dois dmd à Tiziana       ************************/
/************** split par code_cess ****************************/

proc sql;
create table bgd_cession_resultat as
select /*distinct*/ 
sum((case when poste in ("PRIMES","ENT_PTF") then cess
      when poste = "PPNA" then -cess else 0 end)) as GEP,
      
sum((case when poste ="COMMACQ_CD" then cess else 0 end)) as COMMISSIONS,
sum((case when poste = "FAR_CD" then cess else 0 end)) as FAR_CLOT,
sum((Case when poste = "SINISTRES" then cess else 0 end)) as SINISTRES,
sum((case when poste in ("PSAP","PM","PSAP","PTEC") then cess else 0 end)) as Prov_clot,
gar
            
      from bgd_cqs_cession

      where gen=&N.
      
      group by gar;
      
quit;

data bgd_cession_resultat;
set bgd_cession_resultat;
resultat=GEP-(COMMISSIONS-FAR_CLOT)-SINISTRES-PROV_clot;
PS=min(0,0.8*(resultat-0.06*GEP));
typaff=11;
run;

data bgd_cession_resultat ;
set bgd_cession_resultat ;
keep gar typaff PS resultat;
run;

data cle_repart;
length cessionnaire $20;
format gar quota_share 8.2 ;
format code_cess 8.;
run;

/*prorata selon le quota share faut que la somme fasse 100%*/

data cle_repart;
    length cessionnaire $20;
    length code_cess $20;
    input gar cessionnaire code_cess quota_share;
    datalines;
10 GEN_RE 75 0.58
10 HANOVER_RE 90 0.25
10 MAPFRE 91 0.17
30 GEN_RE 75 0.58
30 HANOVER_RE 90 0.25
30 MAPFRE 91 0.17
;
run;

proc sql;
create table bgd_cession_resultat2 
as select a.*,
b.quota_share , b.code_cess
from bgd_cession_resultat a left join cle_repart b
on a.gar=b.gar; 
quit;


