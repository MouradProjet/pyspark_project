proc sql;
create table UEP as select 
idean,gen , SURV, gar, Type_Pret,sum(UEP) as PPNA 
from cqs_out.cqs_uep_pl_3
group by idean, Gen,SURV, gar, Type_Pret ; 
quit;

data UEP;
